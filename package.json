{
  "name": "website-contact-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that extracts public business contact information from the active website and stores leads locally.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "chrome-extension",
    "lead-generation",
    "contact-extractor"
  ],
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
