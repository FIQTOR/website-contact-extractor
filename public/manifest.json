{
  "manifest_version": 3,
  "name": "Website Contact Extractor",
  "version": "1.0.0",
  "description": "Extract public business contact details from the active website and manage them as local leads.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_title": "Website Contact Extractor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
